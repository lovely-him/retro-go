# rg_tool.py 将本文件设为 SDKCONFIG_DEFAULTS，仅在生成新 sdkconfig 时生效。
# 未列出的选项一律采用 IDF 对 esp32p4 的默认值，避免抄入其它 target 的陈旧符号。

# ---- Target ----
CONFIG_IDF_TARGET="esp32p4"

# ---- 芯片版本：最小版本 v1.* ----
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
# CONFIG_ESP32P4_REV_MIN_100=y

# ---- 芯片版本：最小版本 v3.* ----
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=n
CONFIG_ESP32P4_REV_MIN_300=y

# ---- Flash：板载 16MB NOR ----
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# ---- PSRAM：封装内 32MB。P4 为 HEX 模式（Kconfig 默认即 HEX，此处显式声明）----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_FLASH_LOAD_TO_PSRAM=y

# ---- Cache ----
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# ---- CPU / FreeRTOS ----
CONFIG_PM_ENABLE=n
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ---- Compiler : 优化等级 ----
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# ---- Compiler : 断言报错 ----
# CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
# ---- Compiler : 日志等级 ----
# CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y
# ---- Compiler : 打印简化 ----
# CONFIG_LIBC_NEWLIB_NANO_FORMAT=y

# ---- FATFS：retro-go 要求长文件名 + UTF-8（板级例程默认 LFN_NONE，必须覆盖）----
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_CODEPAGE_437=y
CONFIG_FATFS_USE_FASTSEEK=y

# ---- 压制 rg_input.c 无条件包含 legacy <driver/adc.h> 产生的 #warning ----
CONFIG_ADC_SUPPRESS_DEPRECATE_WARN=y

# ---- 实验特性"可见性"开关 ----
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# ---- 临时占位分区表 ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="../partitions.csv"

# ---- USB Host：P4 USB PHY 连接 Hub  ----
# CONFIG_USB_HOST_HUBS_SUPPORTED=y

