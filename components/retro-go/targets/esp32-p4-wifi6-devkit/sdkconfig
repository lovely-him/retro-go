# rg_tool.py 将本文件设为 SDKCONFIG_DEFAULTS，仅在生成新 sdkconfig 时生效。
# 未列出的选项一律采用 IDF 对 esp32p4 的默认值，避免抄入其它 target 的陈旧符号。

# ---- Target ----
CONFIG_IDF_TARGET="esp32p4"

# ---- 芯片版本：最小版本 v1.* ----
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
# CONFIG_ESP32P4_REV_MIN_100=y

# ---- 芯片版本：最小版本 v3.* ----
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=n
CONFIG_ESP32P4_REV_MIN_300=y

# ---- Flash：板载 16MB NOR ----
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ---- PSRAM：封装内 32MB。P4 为 HEX 模式（Kconfig 默认即 HEX，此处显式声明）----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_FLASH_LOAD_TO_PSRAM=y

# ---- Cache ----
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# ---- CPU / FreeRTOS ----
CONFIG_PM_ENABLE=n
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240

# ---- Compiler ----
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ---- FATFS：retro-go 要求长文件名 + UTF-8（板级例程默认 LFN_NONE，必须覆盖）----
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_CODEPAGE_437=y

# ---- 压制 rg_input.c 无条件包含 legacy <driver/adc.h> 产生的 #warning ----
CONFIG_ADC_SUPPRESS_DEPRECATE_WARN=y

# ---- USB Host：drivers/input/usb_hid.c 的 boot 键盘 ----
# 板上 Type-A 口经 CH334 hub 接到 P4 的 USB2.0 OTG HS 控制器，键盘挂在 hub 下游。
# 不开这个选项，components/usb 不会编入 ext_hub.c / ext_port.c，hub 下游设备根本
# 不会被枚举。其余 USB 选项（含 HUB_MULTI_LEVEL=y）取 IDF 默认即可。
CONFIG_USB_HOST_HUBS_SUPPORTED=y

# ---- 板级平台例程所用 ----
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# ---- 分区表 ----
# rg_tool.py 在仓库根生成占位 partitions.csv(dummy, app, ota_0, 65536, 3145728)，
# 各 app 用 "../partitions.csv" 指向它，以避免 IDF 默认的 1MB factory 分区触发
# app_check_size 失败。真实分区布局由 tools/mkfw.py 在打包镜像时生成。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="../partitions.csv"

# ---- Wi-Fi 经 ESP32-C6 协处理器(ESP-Hosted) ----
# 下面整段【逐字抄自】git_repository/esp-claw/application/edge_agent/sdkconfig ——
# 那是同一块板、同一份 C6 slave 固件(ESP-Hosted 2.12.3)、同一个 IDF v5.5 上已经跑通
# 的配置。不自己挑值, 免得同时引入两个变量。
#
# 其中一部分是派生项(例如 CONFIG_ESP_HOSTED_SDIO_PIN_CMD 由 ..._PRIV_SDIO_PIN_CMD_SLOT_1
# 算出来), 写在这里冗余但无害: IDF 生成 sdkconfig 时会重算。保留只是为了与已验证的
# 那份完全一致。将来若要为体积瘦身, 从 CONFIG_ESP_HOSTED_CLI_ENABLED 和
# CONFIG_WIFI_RMT_ENTERPRISE_SUPPORT 这类明显用不上的开始砍。
#
# 引脚与板级头文件 board/esp32p4_wifi6_dev_kit.h 第 5 节完全对应:
#   4-bit SDIO, slot 1, CLK=GPIO18 CMD=GPIO19 D0..D3=GPIO14..17, C6 复位=GPIO54 高有效,
#   时钟 40MHz。
#
# 只有 launcher 会用到(见 launcher/main/idf_component.yml)。四个核心把
# RG_ENABLE_NETWORKING 强制为 0, 不会解析到这些组件。
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_PRIV_ENABLE_WIFI_OPTIONS=y
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c6"
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_PRIV_SDIO_OPTION=y
CONFIG_ESP_HOSTED_PRIV_SPI_HD_OPTION=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_SLOT=1
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_BUS_WIDTH=4
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=19
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=18
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=14
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=15
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=16
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=17
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_SDIO_PRIV_PIN_D1_4BIT_BUS=15
CONFIG_ESP_HOSTED_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_SDIO_PIN_D3=17
CONFIG_ESP_HOSTED_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_SDIO_TX_Q_SIZE=20
CONFIG_ESP_HOSTED_SDIO_RX_Q_SIZE=20
CONFIG_ESP_HOSTED_SDIO_RESET_DELAY_MS=1500
CONFIG_ESP_HOSTED_SLAVE_RESET_ON_EVERY_HOST_BOOTUP=y
CONFIG_ESP_HOSTED_GPIO_SLAVE_RESET_SLAVE=54
CONFIG_ESP_HOSTED_RPC_TASK_STACK=4096
CONFIG_ESP_HOSTED_DFLT_TASK_STACK=3072
CONFIG_ESP_HOSTED_TRANSPORT_RESTART_ON_FAILURE=y
CONFIG_ESP_HOSTED_MEM_MONITOR=y
CONFIG_ESP_HOSTED_ENABLE_ITWT=y
CONFIG_ESP_HOSTED_USE_MEMPOOL=y
CONFIG_ESP_HOSTED_MAX_SIMULTANEOUS_SYNC_RPC_REQUESTS=5
CONFIG_ESP_HOSTED_MAX_SIMULTANEOUS_ASYNC_RPC_REQUESTS=5
CONFIG_ESP_HOSTED_CLI_ENABLED=y
CONFIG_ESP_HOSTED_HOST_TO_ESP_WIFI_DATA_THROTTLE=y
CONFIG_ESP_HOSTED_PRIV_WIFI_TX_SDIO_HIGH_THRESHOLD=80
CONFIG_ESP_HOSTED_TO_WIFI_DATA_THROTTLE_HIGH_THRESHOLD=80
CONFIG_ESP_HOSTED_TO_WIFI_DATA_THROTTLE_LOW_THRESHOLD=60
CONFIG_ESP_HOSTED_ENABLE_PEER_DATA_TRANSFER=y
CONFIG_ESP_HOSTED_MAX_CUSTOM_MSG_HANDLERS=3

# ---- esp_wifi_remote: 注入版 esp_wifi.h 里 WIFI_INIT_CONFIG_DEFAULT() 展开用到的值 ----
